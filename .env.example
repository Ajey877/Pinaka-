# Pinaka server
HOST=0.0.0.0
PORT=3000

# GitHub OAuth web application / GitHub App user-authorization settings
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback
GITHUB_OAUTH_SCOPE=repo read:user user:email

# Use 1 when Pinaka is served over HTTPS.
PINAKA_COOKIE_SECURE=0
PINAKA_SESSION_TTL_MS=28800000
PINAKA_SESSION_COOKIE=pinaka_session

# Optional server-wide fallback for non-authenticated maintenance tasks.
GITHUB_TOKEN=

# Model provider
PINAKA_MODEL=
PINAKA_MODEL_BASE_URL=https://openrouter.ai/api/v1
PINAKA_MODEL_API_KEY=
