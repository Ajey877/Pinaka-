# Pinaka server
HOST=0.0.0.0
PORT=3000

# GitHub OAuth web application settings
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback
GITHUB_OAUTH_SCOPE=repo read:user

# Set this to the externally reachable Pinaka origin in production.
PINAKA_PUBLIC_ORIGIN=http://localhost:3000

# Use 1 when Pinaka is served over HTTPS.
PINAKA_COOKIE_SECURE=0
PINAKA_SESSION_TTL_MS=28800000
PINAKA_SESSION_COOKIE=pinaka_session
PINAKA_CSRF_COOKIE=pinaka_csrf

# Model provider
PINAKA_MODEL=
PINAKA_MODEL_BASE_URL=https://openrouter.ai/api/v1
PINAKA_MODEL_API_KEY=
